{
  "manifest_version": 3,
  "name": "Klingon Translator",
  "version": "0.0.4",
  "description": "Translate American English and Brazilian Portuguese into Klingon from a lightweight floating panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Klingon Translator",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "src/background/main.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "klingon-translator@bobbygodias.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
